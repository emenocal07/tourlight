{
  "name": "tourlight-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build:core && vitest run",
    "typecheck": "npm run build:libs && npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "build:core": "npm run build -w @emenocal07/tourlight-core",
    "build:libs": "npm run build -w @emenocal07/tourlight-core && npm run build -w @emenocal07/tourlight",
    "smoke": "npm run build:libs && node scripts/smoke.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/cli": "^2.31.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
