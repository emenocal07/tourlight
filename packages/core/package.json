{
  "name": "@emenocal07/tourlight-core",
  "version": "0.1.0",
  "description": "Internal building block of Tourlight: the framework-agnostic state machine and persistence logic. Most apps want @emenocal07/tourlight.",
  "license": "MIT",
  "author": "Ernesto Espinoza Menocal (https://github.com/emenocal07)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emenocal07/tourlight.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/emenocal07/tourlight#readme",
  "bugs": {
    "url": "https://github.com/emenocal07/tourlight/issues"
  },
  "keywords": [
    "tour",
    "onboarding",
    "state-machine",
    "typescript",
    "tourlight"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/copyPackageDocs.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
